{
  "expo": {
    "name": "Caronas ICEA",
    "slug": "caronas-icea",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.ufop.caronasicea"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A3D62"
      },
      "package": "br.edu.ufop.caronasicea"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Caronas ICEA - UFOP",
      "shortName": "Caronas ICEA",
      "description": "Sistema de Caronas Universitárias para o Campus ICEA UFOP",
      "themeColor": "#0A3D62",
      "backgroundColor": "#0A3D62",
      "display": "standalone",
      "orientation": "portrait"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0A3D62"
        }
      ],
      "expo-sqlite"
    ]
  }
}
